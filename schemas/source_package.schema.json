{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "package_revision": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "source_text",
        "dictionary",
        "lexemes",
        "crosswalks",
        "analysis",
        "versification",
        "cross_alignment"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "package_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "package_id",
          "sha256"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream_url": {
          "type": "string",
          "minLength": 1
        },
        "upstream_revision": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "license_text_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "upstream_url",
        "upstream_revision",
        "license",
        "license_text_sha256",
        "attribution"
      ]
    },
    "review_status": {
      "enum": [
        "pending",
        "approved"
      ]
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "source_id",
    "package_revision",
    "kind",
    "files",
    "dependencies",
    "provenance",
    "review_status"
  ]
}
