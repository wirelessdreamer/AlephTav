{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewDecisionV2",
  "type": "object",
  "required": [
    "decision_id", "target_id", "reviewer_role", "reviewer", "decision", "notes", "timestamp",
    "contract_version", "principal", "channel", "payload_digest", "policy_revision"
  ],
  "additionalProperties": false,
  "properties": {
    "decision_id": { "type": "string", "maxLength": 200, "pattern": "^rev\\.(?:(?:lxx\\.[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*\\.r[0-9]{4,}\\.)|lxx\\.)?ps\\d{3}\\.v\\d{3}\\.[a-z]\\.\\d{4}$" },
    "target_id": { "type": "string", "maxLength": 200, "pattern": "^rnd\\.(?:(?:lxx\\.[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*\\.r[0-9]{4,}\\.)|lxx\\.)?ps\\d{3}\\.v\\d{3}\\.[a-z]\\.[a-z_]+\\.(can|alt)\\.\\d{4}$" },
    "reviewer_role": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "decision": { "type": "string", "enum": ["approve", "accept-alternate", "reject", "request_changes", "withdraw"] },
    "notes": { "type": "string", "maxLength": 10000 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "not": { "pattern": "\\s" }
    },
    "contract_version": { "type": "integer", "const": 2 },
    "principal": {
      "type": "object",
      "required": ["principal_id", "kind"],
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "not": { "pattern": "\\s" }
        },
        "kind": { "type": "string", "enum": ["human", "agent"] }
      }
    },
    "channel": { "type": "string", "enum": ["ui", "api", "cli", "mcp", "import"] },
    "payload_digest": { "$ref": "#/$defs/payloadDigest" },
    "policy_revision": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "mcp" } }, "required": ["channel"] },
      "then": { "properties": { "principal": { "properties": { "kind": { "const": "agent" } } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
    "payloadDigest": {
      "type": "object",
      "required": ["version", "algorithm", "value"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "algorithm": { "type": "string", "const": "sha256" },
        "value": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
