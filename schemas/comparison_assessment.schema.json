{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComparisonAssessment",
  "type": "object",
  "required": [
    "comparison_id",
    "psalm_id",
    "unit_id",
    "mt_reference",
    "display_reference",
    "hebrew_text",
    "literal_rendering_id",
    "english_rendering_id",
    "accuracy_rating",
    "accuracy_note",
    "creative_liberties_note",
    "status",
    "created_by",
    "created_via",
    "generator_provider",
    "generation_run_id",
    "reviewer_id",
    "reviewed_at",
    "revision_of",
    "audit_ids",
    "literal_backbone",
    "word_notes",
    "non_source_material",
    "analyzed_text_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "comparison_id": {
      "type": "string",
      "pattern": "^cmp\\.ps\\d{3}\\.v\\d{3}\\.[a-z]\\.\\d{4}$"
    },
    "psalm_id": {
      "type": "string",
      "pattern": "^ps\\d{3}$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^ps\\d{3}\\.v\\d{3}\\.[a-z]$"
    },
    "mt_reference": {
      "type": "string",
      "description": "Masoretic reference. Kept separate from display_reference so a superscription is never silently renumbered as verse one."
    },
    "display_reference": {
      "type": "string",
      "description": "User-facing English reference, which may differ from the MT numbering."
    },
    "hebrew_text": {
      "type": "string"
    },
    "literal_rendering_id": {
      "type": ["string", "null"],
      "description": "Null when no literal rendering is selected; the row renders incomplete rather than inventing text."
    },
    "english_rendering_id": {
      "type": ["string", "null"],
      "description": "Null when no English rendering is selected; the row renders incomplete rather than inventing text."
    },
    "accuracy_rating": {
      "type": ["string", "null"],
      "description": "Relationship of the English used to the Hebrew. The first six describe a relationship to the source; no_source_basis asserts the absence of one.",
      "enum": [
        "literal",
        "very_close",
        "close",
        "adapted",
        "interpretive",
        "omission",
        "no_source_basis",
        null
      ]
    },
    "accuracy_note": {
      "type": "string"
    },
    "creative_liberties_note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "reviewed",
        "accepted_as_alternate",
        "canonical",
        "rejected",
        "superseded"
      ]
    },
    "created_by": {
      "type": "string"
    },
    "created_via": {
      "type": "string",
      "enum": [
        "human",
        "codex",
        "local_model",
        "deterministic"
      ]
    },
    "generator_provider": {
      "type": ["string", "null"]
    },
    "generation_run_id": {
      "type": ["string", "null"]
    },
    "reviewer_id": {
      "type": ["string", "null"]
    },
    "reviewed_at": {
      "type": ["string", "null"]
    },
    "revision_of": {
      "type": ["string", "null"],
      "description": "Set when this assessment supersedes an earlier one. A review never overwrites the original."
    },
    "audit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "literal_backbone": {
      "description": "Compact literal rendering of this unit, one entry per clause. Evidence for the accuracy verdict; never promoted to a literal-layer rendering.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "word_notes": {
      "description": "Per-word translation notes. Anchored to existing token ids; an array because bound phrases such as kevod shemo span several tokens.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "token_ids",
          "transliteration",
          "lexical_gloss",
          "rendered_as",
          "verdict",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "token_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^ps\\d{3}\\.v\\d{3}\\.t\\d{3}$"
            }
          },
          "transliteration": { "type": "string" },
          "lexical_gloss": { "type": "string" },
          "rendered_as": { "type": "string" },
          "verdict": {
            "type": "string",
            "enum": [
              "standard",
              "defensible",
              "expansion",
              "narrowing",
              "nonstandard",
              "unsupported",
              "omitted"
            ]
          },
          "note": { "type": "string" }
        }
      }
    },
    "non_source_material": {
      "description": "Material in the English with no counterpart in the Hebrew: performance and arrangement apparatus. Required to be non-empty before accuracy_rating may be no_source_basis.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "kind", "note"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "meter",
              "instrumentation",
              "vocal_assignment",
              "section_label",
              "dynamics",
              "other"
            ]
          },
          "note": { "type": "string" }
        }
      }
    },
    "analyzed_text_hash": {
      "description": "Fingerprint of the rendering text this assessment audited, plus the Hebrew source. Null on human-authored assessments. Recomputed at read time to detect a rendering edited in place under the same id.",
      "type": ["string", "null"]
    }
  }
}
