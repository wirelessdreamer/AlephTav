{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PsalmUnit",
  "type": "object",
  "required": [
    "psalm_id",
    "unit_id",
    "ref",
    "segmentation_type",
    "source_hebrew",
    "source_transliteration",
    "token_ids",
    "concept_ids",
    "status",
    "current_layer_state",
    "canonical_rendering_ids",
    "alternate_rendering_ids",
    "audit_ids",
    "issue_links",
    "pr_links",
    "tokens",
    "alignments",
    "renderings",
    "audit_records",
    "review_decisions",
    "witnesses"
  ],
  "additionalProperties": false,
  "properties": {
    "psalm_id": { "type": "string", "pattern": "^ps\\d{3}$" },
    "unit_id": { "type": "string", "pattern": "^ps\\d{3}\\.v\\d{3}\\.[a-z]$" },
    "ref": { "type": "string" },
    "segmentation_type": { "type": "string", "enum": ["verse", "colon"] },
    "source_hebrew": { "type": "string" },
    "source_transliteration": { "type": "string" },
    "token_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "concept_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "under_review", "canonical", "accepted_as_alternate", "rejected", "deprecated"]
    },
    "current_layer_state": {
      "type": "object",
      "required": ["locked_layers", "latest_layer"],
      "additionalProperties": false,
      "properties": {
        "locked_layers": { "type": "array", "items": { "type": "string" } },
        "latest_layer": { "type": "string" }
      }
    },
    "canonical_rendering_ids": { "type": "array", "items": { "type": "string" } },
    "alternate_rendering_ids": { "type": "array", "items": { "type": "string" } },
    "audit_ids": { "type": "array", "items": { "type": "string" } },
    "issue_links": { "type": "array", "items": { "type": "string" } },
    "pr_links": { "type": "array", "items": { "type": "string" } },
    "tokens": { "type": "array", "items": { "$ref": "token.schema.json" } },
    "alignments": { "type": "array", "items": { "$ref": "alignment.schema.json" } },
    "renderings": { "type": "array", "items": { "$ref": "rendering.schema.json" } },
    "comparison_assessments": { "type": "array", "items": { "$ref": "comparison_assessment.schema.json" } },
    "verse_notes": {
      "description": "A reviewer's notes on this verse, each in the translation it was written for (no translation_id: the psalm's main one). Instructions steer that translation's next rebuild; the accuracy audit never sees them.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["note_id", "text", "applies_to", "kind", "status", "created_at", "created_by"],
        "additionalProperties": false,
        "properties": {
          "note_id": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "applies_to": { "type": "string", "enum": ["literal", "english", "both"] },
          "kind": { "type": "string", "enum": ["instruction", "comment"] },
          "status": { "type": "string", "enum": ["open", "addressed"] },
          "quote": { "type": "string" },
          "token_ids": { "type": "array", "items": { "type": "string" } },
          "addressed_in": { "type": "string" },
          "created_at": { "type": "string" },
          "created_by": { "type": "string" },
          "updated_at": { "type": "string" },
          "translation_id": { "type": "string", "pattern": "^tr\\.ps\\d{3}\\.\\d{4}$" }
        }
      }
    },
    "rebuilds": {
      "description": "Retranslations of this verse with its notes, at most one pending per translation. A pending rebuild's renderings stay out of the table until it is accepted.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rebuild_id",
          "status",
          "english_layer",
          "note_ids",
          "rendering_ids",
          "previous_rendering_ids",
          "note_responses",
          "run_ids",
          "analysis",
          "created_at",
          "created_by"
        ],
        "additionalProperties": false,
        "properties": {
          "rebuild_id": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "accepted", "discarded"] },
          "english_layer": { "type": "string" },
          "note_ids": { "type": "array", "items": { "type": "string" } },
          "rendering_ids": { "type": "object", "additionalProperties": { "type": "string" } },
          "previous_rendering_ids": {
            "type": "object",
            "additionalProperties": { "type": ["string", "null"] }
          },
          "note_responses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["note_id", "response"],
              "additionalProperties": false,
              "properties": {
                "note_id": { "type": "string" },
                "response": { "type": "string" }
              }
            }
          },
          "run_ids": { "type": "array", "items": { "type": "string" } },
          "analysis": {
            "description": "The blind audit of the rebuilt text, held until the rebuild is accepted.",
            "type": ["object", "null"]
          },
          "created_at": { "type": "string" },
          "created_by": { "type": "string" },
          "decided_at": { "type": "string" },
          "decided_by": { "type": "string" },
          "translation_id": { "type": "string", "pattern": "^tr\\.ps\\d{3}\\.\\d{4}$" }
        }
      }
    },
    "audit_records": { "type": "array", "items": { "$ref": "audit_record.schema.json" } },
    "review_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "target_id", "reviewer_role", "reviewer", "decision", "notes", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "decision_id": { "type": "string", "pattern": "^rev\\.ps\\d{3}\\.v\\d{3}\\.[a-z]\\.\\d{4}$" },
          "target_id": { "type": "string" },
          "reviewer_role": { "type": "string" },
          "reviewer": { "type": "string" },
          "decision": { "type": "string" },
          "notes": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    },
    "witnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "versionTitle", "language", "ref", "source_url", "text"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string" },
          "versionTitle": { "type": "string" },
          "source_version": { "type": "string" },
          "language": { "type": "string" },
          "witness_role": { "type": "string" },
          "ref": { "type": "string" },
          "source_url": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
