{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegacyReviewDecision",
  "type": "object",
  "required": ["decision_id", "target_id", "reviewer_role", "reviewer", "decision", "notes", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "decision_id": { "type": "string", "pattern": "^rev\\.(?:(?:lxx\\.[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*\\.r[0-9]{4,}\\.)|lxx\\.)?ps\\d{3}\\.v\\d{3}\\.[a-z]\\.\\d{4}$" },
    "target_id": { "type": "string" },
    "reviewer_role": { "type": "string" },
    "reviewer": { "type": "string" },
    "decision": { "type": "string" },
    "notes": { "type": "string" },
    "timestamp": { "type": "string" }
  }
}
