      "psalm_id": "ps027",
      "sections": [
        {
          "kind": "intro",
          "label": "Intro",
          "lines": [
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v001.t001"
                  ],
                  "unit_id": "ps027.v001.a"
                }
              ],
              "approvals": [],
              "liberty": "expanded",
              "line_id": "ln.0001",
              "rationale": "Adds 'a song' to make the attribution a sung introduction.",
              "text": "A song of David."
            }
          ],
          "repeat_of": null,
          "section_id": "sec.0001"
        },
        {
          "kind": "verse",
          "label": "Verse 1",
          "lines": [
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v001.t002",
                    "ps027.v001.t003",
                    "ps027.v001.t004"
                  ],
                  "unit_id": "ps027.v001.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0002",
              "rationale": "",
              "text": "Yahweh, my light and my salvation,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v001.t005",
                    "ps027.v001.t006"
                  ],
                  "unit_id": "ps027.v001.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0003",
              "rationale": "",
              "text": "Whom shall I fear?"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v001.t007",
                    "ps027.v001.t008",
                    "ps027.v001.t009"
                  ],
                  "unit_id": "ps027.v001.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0004",
              "rationale": "",
              "text": "Yahweh, the stronghold of my life,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v001.t010",
                    "ps027.v001.t011"
                  ],
                  "unit_id": "ps027.v001.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0005",
              "rationale": "",
              "text": "Whom shall I dread?"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v002.t001",
                    "ps027.v002.t002",
                    "ps027.v002.t003"
                  ],
                  "unit_id": "ps027.v002.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0006",
              "rationale": "",
              "text": "When evil ones drew near against me"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v002.t004",
                    "ps027.v002.t005",
                    "ps027.v002.t006",
                    "ps027.v002.t007",
                    "ps027.v002.t008",
                    "ps027.v002.t009"
                  ],
                  "unit_id": "ps027.v002.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0007",
              "rationale": "",
              "text": "To eat my flesh—my foes, my enemies—"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v002.t010",
                    "ps027.v002.t011",
                    "ps027.v002.t012"
                  ],
                  "unit_id": "ps027.v002.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0008",
              "rationale": "",
              "text": "They stumbled and they fell."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v003.t001",
                    "ps027.v003.t002",
                    "ps027.v003.t003",
                    "ps027.v003.t004"
                  ],
                  "unit_id": "ps027.v003.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0009",
              "rationale": "",
              "text": "Though an army camps against me,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v003.t005",
                    "ps027.v003.t006",
                    "ps027.v003.t007"
                  ],
                  "unit_id": "ps027.v003.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0010",
              "rationale": "",
              "text": "My heart will have no fear."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v003.t008",
                    "ps027.v003.t009",
                    "ps027.v003.t010",
                    "ps027.v003.t011"
                  ],
                  "unit_id": "ps027.v003.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0011",
              "rationale": "",
              "text": "Though war should rise against me,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v003.t012",
                    "ps027.v003.t013",
                    "ps027.v003.t014"
                  ],
                  "unit_id": "ps027.v003.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0012",
              "rationale": "",
              "text": "In this I put my trust."
            }
          ],
          "repeat_of": null,
          "section_id": "sec.0002"
        },
        {
          "kind": "chorus",
          "label": "Chorus",
          "lines": [
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v014.t001",
                    "ps027.v014.t002",
                    "ps027.v014.t003"
                  ],
                  "unit_id": "ps027.v014.a"
                }
              ],
              "approvals": [],
              "liberty": "reordered",
              "line_id": "ln.0013",
              "rationale": "Moves the closing exhortation forward to serve as the recurring chorus.",
              "text": "Wait for Yahweh."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v014.t004",
                    "ps027.v014.t005",
                    "ps027.v014.t006"
                  ],
                  "unit_id": "ps027.v014.a"
                }
              ],
              "approvals": [],
              "liberty": "reordered",
              "line_id": "ln.0014",
              "rationale": "Moves the heart's closing exhortation forward with the chorus.",
              "text": "Be strong; let your heart take courage."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v014.t007",
                    "ps027.v014.t008",
                    "ps027.v014.t009"
                  ],
                  "unit_id": "ps027.v014.a"
                }
              ],
              "approvals": [],
              "liberty": "compressed",
              "line_id": "ln.0015",
              "rationale": "Moves the final exhortation into the chorus and absorbs its linking 'and' so both calls are sung identically.",
              "text": "Wait for Yahweh."
            }
          ],
          "repeat_of": null,
          "section_id": "sec.0003"
        },
        {
          "kind": "verse",
          "label": "Verse 2",
          "lines": [
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v004.t001",
                    "ps027.v004.t002",
                    "ps027.v004.t003",
                    "ps027.v004.t004"
                  ],
                  "unit_id": "ps027.v004.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0016",
              "rationale": "",
              "text": "One thing I asked of Yahweh,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v004.t005",
                    "ps027.v004.t006"
                  ],
                  "unit_id": "ps027.v004.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0017",
              "rationale": "",
              "text": "And this is what I seek:"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v004.t007",
                    "ps027.v004.t008",
                    "ps027.v004.t009"
                  ],
                  "unit_id": "ps027.v004.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0018",
              "rationale": "",
              "text": "To dwell within the house of Yahweh"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v004.t010",
                    "ps027.v004.t011",
                    "ps027.v004.t012"
                  ],
                  "unit_id": "ps027.v004.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0019",
              "rationale": "",
              "text": "All the days of my life;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v004.t013",
                    "ps027.v004.t014",
                    "ps027.v004.t015"
                  ],
                  "unit_id": "ps027.v004.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0020",
              "rationale": "",
              "text": "To gaze upon Yahweh's beauty"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v004.t016",
                    "ps027.v004.t017"
                  ],
                  "unit_id": "ps027.v004.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0021",
              "rationale": "",
              "text": "And ponder in his temple."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v005.t001",
                    "ps027.v005.t002",
                    "ps027.v005.t003"
                  ],
                  "unit_id": "ps027.v005.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0022",
              "rationale": "",
              "text": "For he will hide me in his shelter"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v005.t004",
                    "ps027.v005.t005"
                  ],
                  "unit_id": "ps027.v005.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0023",
              "rationale": "",
              "text": "In the day of trouble;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v005.t006",
                    "ps027.v005.t007",
                    "ps027.v005.t008"
                  ],
                  "unit_id": "ps027.v005.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0024",
              "rationale": "",
              "text": "He'll hide me in his tent's secret place"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v005.t009",
                    "ps027.v005.t010"
                  ],
                  "unit_id": "ps027.v005.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0025",
              "rationale": "",
              "text": "And raise me high upon a rock."
            }
          ],
          "repeat_of": null,
          "section_id": "sec.0004"
        },
        {
          "kind": "verse",
          "label": "Verse 3",
          "lines": [
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v006.t001",
                    "ps027.v006.t002",
                    "ps027.v006.t003"
                  ],
                  "unit_id": "ps027.v006.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0026",
              "rationale": "",
              "text": "Now my head will rise"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v006.t004",
                    "ps027.v006.t005",
                    "ps027.v006.t006"
                  ],
                  "unit_id": "ps027.v006.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0027",
              "rationale": "",
              "text": "Above the foes around me."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v006.t007",
                    "ps027.v006.t008",
                    "ps027.v006.t009"
                  ],
                  "unit_id": "ps027.v006.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0028",
              "rationale": "",
              "text": "I'll offer sacrifices in his tent"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v006.t010"
                  ],
                  "unit_id": "ps027.v006.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0029",
              "rationale": "",
              "text": "With shouts of joy."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v006.t011",
                    "ps027.v006.t012",
                    "ps027.v006.t013"
                  ],
                  "unit_id": "ps027.v006.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0030",
              "rationale": "",
              "text": "I'll sing, I'll sing praise to Yahweh."
            }
          ],
          "repeat_of": null,
          "section_id": "sec.0005"
        },
        {
          "kind": "chorus",
          "label": "Chorus",
          "lines": [],
          "repeat_of": "sec.0003",
          "section_id": "sec.0006"
        },
        {
          "kind": "bridge",
          "label": "Bridge",
          "lines": [
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v007.t001",
                    "ps027.v007.t002",
                    "ps027.v007.t003",
                    "ps027.v007.t004"
                  ],
                  "unit_id": "ps027.v007.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0031",
              "rationale": "",
              "text": "Hear my voice, O Yahweh, when I call;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v007.t005",
                    "ps027.v007.t006"
                  ],
                  "unit_id": "ps027.v007.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0032",
              "rationale": "",
              "text": "Show me grace and answer me."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v008.t001",
                    "ps027.v008.t002",
                    "ps027.v008.t003",
                    "ps027.v008.t004",
                    "ps027.v008.t005"
                  ],
                  "unit_id": "ps027.v008.a"
                }
              ],
              "approvals": [],
              "liberty": "expanded",
              "line_id": "ln.0033",
              "rationale": "Interprets the difficult Hebrew opening as the heart voicing God's invitation, making the implied source of the call explicit.",
              "text": "My heart speaks your call: 'Seek my face.'"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v008.t006",
                    "ps027.v008.t007",
                    "ps027.v008.t008",
                    "ps027.v008.t009"
                  ],
                  "unit_id": "ps027.v008.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0034",
              "rationale": "",
              "text": "Your face, O Yahweh, I will seek."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v009.t001",
                    "ps027.v009.t002",
                    "ps027.v009.t003",
                    "ps027.v009.t004"
                  ],
                  "unit_id": "ps027.v009.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0035",
              "rationale": "",
              "text": "Do not hide your face from me;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v009.t005",
                    "ps027.v009.t006",
                    "ps027.v009.t007",
                    "ps027.v009.t008"
                  ],
                  "unit_id": "ps027.v009.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0036",
              "rationale": "",
              "text": "Do not turn your servant away in anger."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v009.t009",
                    "ps027.v009.t010"
                  ],
                  "unit_id": "ps027.v009.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0037",
              "rationale": "",
              "text": "You have been my help."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v009.t011",
                    "ps027.v009.t012",
                    "ps027.v009.t013",
                    "ps027.v009.t014"
                  ],
                  "unit_id": "ps027.v009.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0038",
              "rationale": "",
              "text": "Do not leave me; do not forsake me,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v009.t015",
                    "ps027.v009.t016"
                  ],
                  "unit_id": "ps027.v009.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0039",
              "rationale": "",
              "text": "O God of my salvation."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v010.t001",
                    "ps027.v010.t002",
                    "ps027.v010.t003",
                    "ps027.v010.t004"
                  ],
                  "unit_id": "ps027.v010.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0040",
              "rationale": "",
              "text": "If my father and mother forsake me,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v010.t005",
                    "ps027.v010.t006"
                  ],
                  "unit_id": "ps027.v010.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0041",
              "rationale": "",
              "text": "Yahweh will gather me in."
            }
          ],
          "repeat_of": null,
          "section_id": "sec.0007"
        },
        {
          "kind": "verse",
          "label": "Verse 4",
          "lines": [
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v011.t001",
                    "ps027.v011.t002",
                    "ps027.v011.t003"
                  ],
                  "unit_id": "ps027.v011.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0042",
              "rationale": "",
              "text": "Teach me your way, O Yahweh;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v011.t004",
                    "ps027.v011.t005",
                    "ps027.v011.t006"
                  ],
                  "unit_id": "ps027.v011.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0043",
              "rationale": "",
              "text": "Lead me on a level path"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v011.t007",
                    "ps027.v011.t008"
                  ],
                  "unit_id": "ps027.v011.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0044",
              "rationale": "",
              "text": "Because of my enemies."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v012.t001",
                    "ps027.v012.t002",
                    "ps027.v012.t003",
                    "ps027.v012.t004"
                  ],
                  "unit_id": "ps027.v012.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0045",
              "rationale": "",
              "text": "Do not give me to my foes' desire,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v012.t005",
                    "ps027.v012.t006",
                    "ps027.v012.t007",
                    "ps027.v012.t008",
                    "ps027.v012.t009"
                  ],
                  "unit_id": "ps027.v012.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0046",
              "rationale": "",
              "text": "For false witnesses rise against me,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v012.t010",
                    "ps027.v012.t011"
                  ],
                  "unit_id": "ps027.v012.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0047",
              "rationale": "",
              "text": "And one who breathes out violence."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps027.v013.t001",
                    "ps027.v013.t002",
                    "ps027.v013.t003"
                  ],
                  "unit_id": "ps027.v013.a"
                }
              ],
              "approvals": [],
              "liberty": "compressed",
              "line_id": "ln.0048",
