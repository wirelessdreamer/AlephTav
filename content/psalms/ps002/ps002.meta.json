                    "ps002.v012.t001",
                    "ps002.v012.t002"
                  ],
                  "unit_id": "ps002.v012.a"
                }
              ],
              "approvals": [],
              "liberty": "expanded",
              "line_id": "ln.0031",
              "rationale": "The line joins two verses, adds awe to trembling, and identifies the son as Messiah.",
              "text": "Celebrate in trembling awe. Kiss Messiah!"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps002.v012.t003",
                    "ps002.v012.t005"
                  ],
                  "unit_id": "ps002.v012.a"
                }
              ],
              "approvals": [],
              "liberty": "expanded",
              "line_id": "ln.0032",
              "rationale": "The warning against perishing becomes immediate danger with an added conversational appeal.",
              "text": "Your very lives are in danger, you know;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps002.v012.t004",
                    "ps002.v012.t007",
                    "ps002.v012.t008",
                    "ps002.v012.t009",
                    "ps002.v012.t010"
                  ],
                  "unit_id": "ps002.v012.a"
                }
              ],
              "approvals": [],
              "liberty": "compressed",
              "line_id": "ln.0033",
              "rationale": "The two anger clauses merge into one image of an imminent explosion.",
              "text": "His anger is about to explode,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps002.v012.t011",
                    "ps002.v012.t012",
                    "ps002.v012.t013",
                    "ps002.v012.t014"
                  ],
                  "unit_id": "ps002.v012.a"
                }
              ],
              "approvals": [],
              "liberty": "expanded",
              "line_id": "ln.0034",
              "rationale": "Blessing for all who seek refuge becomes a conditional personal invitation, with God named and blessing expressed as freedom from regret.",
              "text": "But if you make a run for God - you won't regret it!"
