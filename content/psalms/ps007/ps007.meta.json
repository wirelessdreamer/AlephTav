              "anchors": [
                {
                  "token_ids": [
                    "ps007.v014.t001",
                    "ps007.v014.t002"
                  ],
                  "unit_id": "ps007.v014.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0047",
              "rationale": "",
              "text": "ready for him;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v014.t005",
                    "ps007.v014.t006",
                    "ps007.v014.t007"
                  ],
                  "unit_id": "ps007.v014.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0048",
              "rationale": "",
              "text": "he sets his arrows burning."
            }
          ],
          "repeat_of": null,
          "section_id": "sec.0006"
        },
