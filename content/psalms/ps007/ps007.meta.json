        {
          "kind": "bridge",
          "label": "Bridge — Trouble returns",
          "lines": [
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v015.t001",
                    "ps007.v015.t002",
                    "ps007.v015.t003"
