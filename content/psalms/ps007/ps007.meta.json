            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v016.t003"
                  ],
                  "unit_id": "ps007.v016.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0053",
              "rationale": "",
              "text": "he hollowed it out,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v016.t004",
                    "ps007.v016.t005"
                  ],
                  "unit_id": "ps007.v016.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0054",
              "rationale": "",
              "text": "then fell in the hole"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v016.t006"
                  ],
                  "unit_id": "ps007.v016.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0055",
              "rationale": "",
              "text": "he'd made."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v017.t001",
                    "ps007.v017.t002"
                  ],
                  "unit_id": "ps007.v017.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0056",
              "rationale": "",
              "text": "His trouble will return"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v017.t003"
                  ],
                  "unit_id": "ps007.v017.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0057",
              "rationale": "",
              "text": "on his own head;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v017.t006",
                    "ps007.v017.t007"
                  ],
                  "unit_id": "ps007.v017.a"
                }
              ],
              "approvals": [],
              "liberty": "reordered",
              "line_id": "ln.0058",
              "rationale": "The subject and descending action precede their destination to match the preceding pair of lines.",
              "text": "his violence will fall"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v017.t004",
                    "ps007.v017.t005"
                  ],
                  "unit_id": "ps007.v017.a"
                }
