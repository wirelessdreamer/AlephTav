          "repeat_of": null,
          "section_id": "sec.0005"
        },
        {
          "kind": "verse",
          "label": "Verse 4 — Shield and weapons",
          "lines": [
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v011.t001",
                    "ps007.v011.t002",
                    "ps007.v011.t003"
                  ],
                  "unit_id": "ps007.v011.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0038",
              "rationale": "",
              "text": "My shield is with God;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v011.t004",
                    "ps007.v011.t005",
                    "ps007.v011.t006"
                  ],
                  "unit_id": "ps007.v011.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0039",
              "rationale": "",
              "text": "he saves the upright in heart."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v012.t001",
                    "ps007.v012.t002",
                    "ps007.v012.t003"
                  ],
                  "unit_id": "ps007.v012.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0040",
              "rationale": "",
              "text": "God is a righteous judge,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v012.t004",
                    "ps007.v012.t005",
                    "ps007.v012.t006",
                    "ps007.v012.t007"
                  ],
                  "unit_id": "ps007.v012.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0041",
              "rationale": "",
              "text": "a God who is angry each day."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v013.t001",
                    "ps007.v013.t002",
                    "ps007.v013.t003"
                  ],
                  "unit_id": "ps007.v013.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0042",
              "rationale": "",
              "text": "If he doesn't return,"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v013.t004",
                    "ps007.v013.t005"
                  ],
                  "unit_id": "ps007.v013.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0043",
              "rationale": "",
              "text": "he'll sharpen his sword;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v013.t006",
                    "ps007.v013.t007"
                  ],
                  "unit_id": "ps007.v013.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0044",
              "rationale": "",
              "text": "he's drawn his bow"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v013.t008"
                  ],
                  "unit_id": "ps007.v013.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0045",
              "rationale": "",
              "text": "and made it ready."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v014.t002",
                    "ps007.v014.t003",
                    "ps007.v014.t004"
                  ],
                  "unit_id": "ps007.v014.a"
                }
