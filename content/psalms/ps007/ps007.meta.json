              "approvals": [],
              "liberty": "compressed",
              "line_id": "ln.0059",
              "rationale": "The conjunction becomes parallel phrasing while the crown-of-the-head image remains explicit.",
              "text": "on the crown of his head."
            }
          ],
          "repeat_of": null,
          "section_id": "sec.0008"
        },
        {
          "kind": "refrain",
          "label": "Closing refrain",
          "lines": [
