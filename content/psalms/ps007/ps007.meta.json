              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0049",
              "rationale": "",
              "text": "Look—he's in labor with evil;"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v015.t004",
                    "ps007.v015.t005"
                  ],
                  "unit_id": "ps007.v015.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0050",
              "rationale": "",
              "text": "he's conceived trouble"
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v015.t006",
                    "ps007.v015.t007"
                  ],
                  "unit_id": "ps007.v015.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0051",
              "rationale": "",
              "text": "and given birth to lies."
            },
            {
              "anchors": [
                {
                  "token_ids": [
                    "ps007.v016.t001",
                    "ps007.v016.t002"
                  ],
                  "unit_id": "ps007.v016.a"
                }
              ],
              "approvals": [],
              "liberty": "tracks",
              "line_id": "ln.0052",
              "rationale": "",
              "text": "He dug a pit,"
