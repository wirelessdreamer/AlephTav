      ],
      "comparison_id": "cmp.ps007.v007.a.0001",
      "created_by": "codex-analysis",
      "created_via": "codex",
      "creative_liberties_note": "'In anger' leaves the Hebrew possessive 'your' implicit. 'Stand against' interprets the lifting imperative and its prepositional phrase; singular 'rage' compresses the Hebrew plural. 'Wake up' and 'you've ordered' modernize the diction.",
      "display_reference": "Psalm 7:7",
      "english_rendering_id": "rnd.ps007.v007.a.lyric.alt.0001",
      "generation_run_id": "cxr.228f9aec3d10",
      "generator_provider": "codex-app-server",
      "hebrew_text": "ק֘וּמָ֤ה יְהוָ֨ה׀ בְּאַפֶּ֗ךָ הִ֭נָּשֵׂא בְּעַבְר֣וֹת צוֹרְרָ֑י וְע֥וּרָה אֵ֝לַ֗י מִשְׁפָּ֥ט צִוִּֽיתָ׃",
      "literal_backbone": [
        "Rise, Yahweh, in your anger;",
        "lift yourself against the fury of my foes;",
        "awake for me; you have commanded judgment."
      ],
